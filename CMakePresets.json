{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_FBX_FILE_INFO": "ON",
        "BUILD_FBX_VIEWER": "ON"
      }
    },
    {
      "name": "win",
      "displayName": "Windows Release",
      "inherits": "base",
      "cacheVariables": {
        "FBX_SDK_ROOT": "C:/Program Files/Autodesk/FBX/FBX SDK/2020.3.7",
        "FBXVIEWER_SDK_ROOT": "${sourceDir}/SDK/fbxsdk"
      }
    },
    {
      "name": "mac",
      "displayName": "macOS Release",
      "inherits": "base",
      "cacheVariables": {
        "FBX_SDK_ROOT": "/Applications/Autodesk/FBX SDK/2020.3.7",
        "FBXVIEWER_SDK_ROOT": "${sourceDir}/SDK/fbxsdk"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win",
      "configurePreset": "win"
    },
    {
      "name": "mac",
      "configurePreset": "mac"
    }
  ]
}
